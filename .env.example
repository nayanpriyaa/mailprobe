# Copy to .env for local development (npm run dev:api / dev:worker).
DATABASE_URL=mysql://mailprobe:mailprobe@127.0.0.1:3306/mailprobe
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Local dev against the fake SMTP server (npm run dev:smtp) and fixture DNS:
SMTP_PROBE=true
SMTP_HOST_OVERRIDE=127.0.0.1
SMTP_PORT=2525
DNS_MODE=fixtures
# Relative to apps/api and apps/worker, where the dev scripts run.
DNS_FIXTURES_PATH=../../deploy/demo-dns.json
SMTP_MAX_PER_HOST=20
RETRY_BASE_DELAY_MS=10000

# Production (real mail servers). Needs outbound port 25, a HELO name with matching
# forward and reverse DNS for the server's IP, and a real mailbox for MAIL FROM.
# SMTP_PROBE=true
# SMTP_HELO_NAME=verify.yourdomain.com
# SMTP_MAIL_FROM=bounces@yourdomain.com
# DNS_MODE=system
