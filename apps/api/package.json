{
  "name": "@mailprobe/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --conditions=development --env-file-if-exists=../../.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --conditions=development --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@mailprobe/core": "0.1.0",
    "@mailprobe/server": "0.1.0",
    "bullmq": "^5.34.0",
    "express": "^5.1.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mailprobe/fake-smtp": "0.1.0",
    "@mailprobe/worker": "0.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
